# ============================================================
# BSC Enterprise HRMS — Production Environment Variables
# ============================================================
# Copy this file to .env and fill in values for your server.
#
# CRITICAL: UPLOAD_DIR must point to a persistent directory
# OUTSIDE the application deployment folder, otherwise uploaded
# documents will be deleted on every deployment.
# ============================================================

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

# JWT Secret
JWT_SECRET=your_secure_random_jwt_secret

# Persistent Upload Directory (MUST be outside the app folder)
# Hostinger Production Directory:
UPLOAD_DIR=/home/u510366842/persistent_uploads_dvg

# Server Port
PORT=3000

# ── Security / Encryption ─────────────────────────────────────
# Generate once with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, a strong value is auto-generated on first boot and stored in
# server/config/.runtime-secrets.json (gitignored). Setting them explicitly
# is strongly recommended so tokens/encrypted data survive across servers.
JWT_SECRET=
JWT_REFRESH_SECRET=
# Key for AES-256-GCM encryption of sensitive database fields
# (wedding customer notes, call remarks). Keep private; rotating it makes
# previously encrypted values unreadable.
ENCRYPTION_KEY=

# Session & Captcha
# Absolute session lifetime in hours - users who never sign out are logged
# out automatically after this window (token + cookie + client timer).
SESSION_HOURS=6
# Set to true ONLY when the site is served over HTTPS - the session cookie is
# then marked Secure (recommended on Hostinger with SSL enabled).
COOKIE_SECURE=false
# Captcha: server-generated numeric SVG on the sign-in screen; auto-refreshes
# every 30 s in the UI and is always verified server-side. No configuration
# needed and no third-party keys are involved.
