# BSC Textiles Management System - Frontend Environment Configuration
# Copy this file to .env and fill in values for your environment

# API Base URL
# For production: Set to your backend API URL
# For development with proxy: Use /api (vite will proxy to backend)
# For development without proxy: Use http://localhost:5000
VITE_API_URL=/api

# Application title
VITE_APP_TITLE=BSC Textiles Management System
