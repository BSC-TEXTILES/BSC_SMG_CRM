# BSC Textiles Management System - Frontend Production Environment
# Copy this file to .env and fill in values for your production deployment

# API Base URL - must match your backend server
# In production, this should be the full URL to your backend API
# Example: VITE_API_URL=https://yourdomain.com/api
# For development: VITE_API_URL=http://localhost:5000
VITE_API_URL=/api

# Site title
VITE_APP_TITLE=BSC Textiles Management System

# For local development, use:
# VITE_API_URL=http://localhost:5000
